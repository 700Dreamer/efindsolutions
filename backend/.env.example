# Application Configuration
PROJECT_NAME="E-Find & Soft Solutions"
VERSION="2.0.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="your-super-secret-jwt-key-here-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite for dev, Postgres/MySQL in production)
DATABASE_URL="sqlite+aiosqlite:///./efind.db"

# File Uploads: Google Cloud Storage or Local
USE_GCS=false
GCS_BUCKET_NAME="efind-uploads"
GOOGLE_APPLICATION_CREDENTIALS=""
UPLOAD_DIR="./uploads"

# Pesapal Payment Gateway v3
PESAPAL_CONSUMER_KEY="your_pesapal_consumer_key"
PESAPAL_CONSUMER_SECRET="your_pesapal_consumer_secret"
PESAPAL_ENV="sandbox"
PESAPAL_IPN_ID="your_pesapal_ipn_id"
PESAPAL_CALLBACK_URL="http://localhost:3000/payment/callback"

# MTN Mobile Money (MoMo) Collections Open API
MTN_MOMO_SUBSCRIPTION_KEY="your_primary_collections_subscription_key"
MTN_MOMO_API_USER_ID="your_api_user_uuid_v4"
MTN_MOMO_API_KEY="your_momo_api_key"
MTN_MOMO_ENV="sandbox"          # "sandbox" or "live"
MTN_MOMO_TARGET_ENV="sandbox"   # "sandbox" or "mtnuganda"
MTN_MOMO_CURRENCY="UGX"
MTN_MOMO_CALLBACK_URL="http://localhost:8000/api/v1/payments/momo/callback"

# Mapbox Public Key
NEXT_PUBLIC_MAPBOX_TOKEN="pk.your_mapbox_public_token_here"
